{{!-- views/components/apiOnly.handlebars --}}
<div id="clientKey" class="hidden">{{ clientKey }}</div>

<div id="payment-page" class="api-only-page">

  {{!-- Auth overlay --}}
  <div id="auth-overlay" class="auth-overlay" aria-live="polite" aria-busy="true">
    <div class="auth-overlay-card">
      <div class="auth-spinner" aria-hidden="true"></div>
      <div class="auth-overlay-title">Authenticating…</div>
      <div class="auth-overlay-subtitle">Please keep this window open.</div>
    </div>
  </div>

  {{!-- 3DS2 modal --}}
  <div id="threeDS2Modal" class="threeds-modal" hidden aria-hidden="true">
    <div class="threeds-card">
      <button id="threeDS2CloseBtn" type="button" aria-label="Close">✕</button>
      <div id="threeDS2ActionMount"></div>
    </div>
  </div>

  <div class="checkout-container">
    {{!-- Payment --}}
    <div class="payment-section">
      <h2 class="section-title">API-only card checkout</h2>

      {{!-- Header: logo inline + title --}}
      <div class="api-only-header">
        <div class="payment-method-logo" id="card-payment-logo"></div>

        <div class="api-only-header-text">
          <div class="api-only-title-row">
            <h3 class="payment-method-title">Encrypted card data (Custom UI)</h3>

            <span id="cardBrandBadge"
                  hidden
                  class="api-only-brand-badge">
            </span>
          </div>

          <div id="apiOnlyStatus" class="api-only-status" aria-live="polite"></div>
        </div>
      </div>

      {{!-- Main card (white, no grey shell) --}}
      <div class="api-only-card">
        <div id="customCard-container" class="api-only-form">

          {{!-- Holder name (NOT a secured field) --}}
          <div class="adyen-checkout__field">
            <label class="adyen-checkout__label" for="holderName">Cardholder name</label>
            <div class="adyen-checkout__input-wrapper">
              <input
                id="holderName"
                class="adyen-checkout__input"
                autocomplete="cc-name"
                placeholder="John Doe"
              />
            </div>
          </div>

          {{!-- Card number (secured field iframe) --}}
          <div class="adyen-checkout__field">
            <label class="adyen-checkout__label">Card number</label>
            <div class="adyen-checkout__input-wrapper">
              <span class="adyen-checkout__input" data-cse="encryptedCardNumber"></span>
            </div>
          </div>

          {{!-- Expiry + CVC (same line) --}}
          <div class="adyen-checkout__field adyen-checkout__field--two-in-one">
            <div class="adyen-checkout__field">
              <label class="adyen-checkout__label">Expiry date</label>
              <div class="adyen-checkout__input-wrapper">
                <span class="adyen-checkout__input" data-cse="encryptedExpiryDate"></span>
              </div>
            </div>

            <div class="adyen-checkout__field">
              <label class="adyen-checkout__label">CVC</label>
              <div class="adyen-checkout__input-wrapper">
                <span class="adyen-checkout__input" data-cse="encryptedSecurityCode"></span>
              </div>
            </div>
          </div>

          {{!-- Network UI --}}
          <div id="dualBrandContainer" class="dual-brand" hidden>
            <div id="dualBrandLabel" class="dual-brand__label"></div>
            <div id="dualBrandOptions" class="dual-brand__options"></div>
          </div>

          <button id="apiOnlyPayBtn"
                  type="button"
                  class="adyen-checkout__button adyen-checkout__button--pay api-only-paybtn"
                  disabled>
            Pay now
          </button>

          <div class="api-only-helper">
            Fields are hosted in Adyen iframes (encrypted card data). Your server receives only encrypted values.
          </div>

        </div>
      </div>
    </div>

    {{!-- Order summary (inchangé) --}}
    <div class="order-summary-section">
      <h2 class="section-title">Order summary</h2>

      <div class="order-summary-box">
        <div class="order-item">
          <div class="item-icon">
            <img src="/images/sunglasses.png" alt="Sunglasses" class="item-image">
          </div>
          <div class="item-details">
            <span class="item-name">Sunglasses</span>
            <span class="item-price" id="sunglasses-price">€50.00</span>
          </div>
        </div>

        <div class="order-item">
          <div class="item-icon">
            <img src="/images/headphones.png" alt="Headphones" class="item-image">
          </div>
          <div class="item-details">
            <span class="item-name">Headphones</span>
            <span class="item-price" id="headphones-price">€50.00</span>
          </div>
        </div>

        <div class="order-divider"></div>

        <div class="order-total">
          <span class="total-label">Total:</span>
          <span class="total-amount" id="total-amount">€100.00</span>
          <span id="total-amount-formatted" class="amount-hidden">10000</span>
        </div>
      </div>
    </div>
  </div>
</div>

{{!-- scripts --}}
<script type="text/javascript" src="/js/locales.js"></script>
<script type="text/javascript" src="/js/currency.js"></script>
<script type="text/javascript" src="/js/uiOverlay.js"></script>
<script type="text/javascript" src="/js/payment-methods/apiOnly.js"></script>
<script src="/js/payment-logos.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    PaymentLogos.loadLogo('card', document.getElementById('card-payment-logo'));
  });

  function updateOrderSummaryCurrency(countryId) {
    const currency = getCurrencyForCountry(countryId);
    const sunglassesPrice = document.getElementById('sunglasses-price');
    const headphonesPrice = document.getElementById('headphones-price');
    const totalAmount = document.getElementById('total-amount');

    if (sunglassesPrice) sunglassesPrice.textContent = formatPrice(5000, currency);
    if (headphonesPrice) headphonesPrice.textContent = formatPrice(5000, currency);
    if (totalAmount) totalAmount.textContent = formatPrice(10000, currency);
  }

  window.addEventListener('countryChanged', (event) => {
    updateOrderSummaryCurrency(event.detail.countryId);
  });

  document.addEventListener('DOMContentLoaded', () => {
    const storedCountry = localStorage.getItem('selectedCountry');
    let countryId = 'FR';
    if (storedCountry) {
      try {
        const parsed = JSON.parse(storedCountry);
        countryId = parsed.id || parsed;
      } catch (e) {
        countryId = storedCountry;
      }
    }
    updateOrderSummaryCurrency(countryId);
  });
</script>